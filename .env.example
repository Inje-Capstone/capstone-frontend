# Browser requests use the Vite origin; /api is proxied to Spring Boot.
VITE_API_BASE_URL=
DEV_API_PROXY_TARGET=http://localhost:8080
DEV_AI_PROXY_TARGET=http://localhost:8000

# Optional: point to an actual recording and its matching AI game identifier.
VITE_REPLAY_GAME_ID=
VITE_REPLAY_VIDEO_URL=

# Development defaults to the /ai-api Vite proxy. No Spring AI proxy is assumed.
VITE_AI_BASE_URL=

# A separate production API origin requires CORS on that server.
# With an empty VITE_API_BASE_URL, production needs a same-origin /api reverse proxy.

# Default: ask every user. Optional: introductory-only (skipped team is saved as NONE).
VITE_TEAM_QUESTION_POLICY=all
# Optional Spring OAuth origin; defaults to VITE_API_BASE_URL or dev proxy.
VITE_OAUTH_BASE_URL=
